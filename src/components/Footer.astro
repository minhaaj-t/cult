---
import { SITE_NAME } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-void-2/50 font-body text-ink-dim">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="font-display text-sm font-bold uppercase tracking-widest text-ink/90">{SITE_NAME}</p>
				<p class="mt-1 text-sm">Where legends live forever.</p>
			</div>
			<p class="max-w-md text-sm leading-relaxed">
				Independent stationery inspired by music culture. Artist and band names refer to the cultural legacy that
				inspires our designs; CultScribe is not affiliated with or endorsed by any rights holders.
			</p>
		</div>
		<p class="mt-8 text-sm text-ink-dim/80">© {year} {SITE_NAME}. All rights reserved.</p>
	</div>
</footer>
