---
type Props = {
	eyebrow?: string;
	title: string;
	subtitle?: string;
};

const { eyebrow = "CultScribe", title, subtitle } = Astro.props;
---

<section
	class="relative flex min-h-[80vh] flex-col justify-end overflow-hidden px-4 pb-20 pt-32 sm:px-6"
	aria-labelledby="hero-title"
>
	<div
		class="absolute inset-0 -z-10 bg-gradient-to-b from-transparent via-void/80 to-void"
		aria-hidden="true"
	/>
	<div
		class="mx-auto w-full max-w-5xl border-l-2 border-accent/60 pl-4 sm:pl-6"
	>
		<p class="font-display text-xs font-semibold uppercase tracking-[0.35em] text-gold">{eyebrow}</p>
		<h1 id="hero-title" class="mt-3 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
			{title}
		</h1>
		{subtitle && (
			<p class="mt-6 max-w-2xl font-body text-xl italic leading-relaxed text-ink-dim sm:text-2xl">
				{subtitle}
			</p>
		)}
	</div>
</section>
