---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, CONTACT_EMAIL } from "../consts";
---

<BaseLayout
	title={`Contact — ${SITE_NAME}`}
	description="Contact CultScribe for wholesale, stockist inquiries, or collaborations. Where legends live forever."
	ogImage="/images/gallery/where-legends-forever-og.webp"
>
	<div class="mx-auto max-w-xl px-4 py-20 sm:px-6">
		<h1 class="font-display text-4xl font-extrabold sm:text-5xl">Contact</h1>
		<p class="mt-6 text-lg text-ink-dim">
			For wholesale, stockist inquiries, or collaborations, reach out. You can also email us at{" "}
			<a class="cult-link focus-ring" href={`mailto:${CONTACT_EMAIL}`}> {CONTACT_EMAIL}</a>
		</p>
		<form id="contact-form" class="mt-12 space-y-6" novalidate>
			<div>
				<label for="name" class="block font-display text-xs font-semibold uppercase tracking-widest text-ink-dim">Name</label>
				<input
					id="name"
					name="name"
					type="text"
					autocomplete="name"
					required
					class="focus-ring mt-2 w-full border border-ink/15 bg-ink/5 px-4 py-3 font-body text-ink placeholder:text-ink-dim/50"
					placeholder="Your name"
				/>
			</div>
			<div>
				<label for="email" class="block font-display text-xs font-semibold uppercase tracking-widest text-ink-dim"
					>Email</label
				>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					class="focus-ring mt-2 w-full border border-ink/15 bg-ink/5 px-4 py-3 font-body text-ink placeholder:text-ink-dim/50"
					placeholder="you@example.com"
				/>
			</div>
			<div>
				<label for="subject" class="block font-display text-xs font-semibold uppercase tracking-widest text-ink-dim"
					>Subject</label
				>
				<input
					id="subject"
					name="subject"
					type="text"
					class="focus-ring mt-2 w-full border border-ink/15 bg-ink/5 px-4 py-3 font-body text-ink placeholder:text-ink-dim/50"
					placeholder="Wholesale, press, or general"
				/>
			</div>
			<div>
				<label for="message" class="block font-display text-xs font-semibold uppercase tracking-widest text-ink-dim"
					>Message</label
				>
				<textarea
					id="message"
					name="message"
					rows="6"
					required
					class="focus-ring mt-2 w-full border border-ink/15 bg-ink/5 px-4 py-3 font-body text-ink placeholder:text-ink-dim/50"
					placeholder="How can we help?"></textarea>
			</div>
			<button
				type="submit"
				class="cult-btn-primary focus-ring w-full sm:w-auto"
				aria-describedby="form-hint"
			>
				Submit
			</button>
			<p class="text-sm text-ink-dim/80" id="form-hint" role="status" aria-live="polite">
				Submit opens your email app with a draft to {CONTACT_EMAIL}. Update that address in code when you use a production
				domain.
			</p>
		</form>
	</div>
	<script define:vars={{ contactEmail: CONTACT_EMAIL }}>
		const form = document.getElementById("contact-form");
		if (form instanceof HTMLFormElement) {
			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const data = new FormData(form);
				const name = (data.get("name") || "").toString();
				const email = (data.get("email") || "").toString();
				const subjectField = (data.get("subject") || "").toString() || "CultScribe inquiry";
				const message = (data.get("message") || "").toString();
				const subject = encodeURIComponent(subjectField);
				const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
				window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
			});
		}
	</script>
</BaseLayout>
