---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, DEFAULT_DESCRIPTION } from "../consts";

type Props = {
	title: string;
	description?: string;
	ogImage?: string;
	/** If false, skip default OG image when page has no ogImage */
	showOgDefault?: boolean;
};

const { title, description = DEFAULT_DESCRIPTION, ogImage, showOgDefault = true } = Astro.props;
const defaultOg = "/images/gallery/where-legends-forever-og.webp";
const og = ogImage ?? (showOgDefault ? defaultOg : undefined);
const siteBase = Astro.site?.href ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, siteBase);
const ogUrl = og ? new URL(og, Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="en" class="bg-void text-ink">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0b" />
		<link rel="canonical" href={canonical.href} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Syne:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical.href} />
		{ogUrl && <meta property="og:image" content={ogUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogUrl && <meta name="twitter:image" content={ogUrl} />}
		<title>{title}</title>
	</head>
	<body class="relative min-h-dvh">
		<div class="cult-vignette" aria-hidden="true" />
		<div class="cult-grain" aria-hidden="true" />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
